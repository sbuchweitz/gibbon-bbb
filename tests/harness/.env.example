# Copy to .env (git-ignored). Both addresses must be reachable from your browser AND from the containers,
# and should use different hosts so the BigBlueButton iframe is cross-site, as in a real deployment.
# Example: GIBBON_URL by host name, BBB_PUBLIC_URL by the same machine's IP address.
GIBBON_URL=http://docker-host.example:2005
BBB_PUBLIC_URL=http://192.0.2.10:2006

# Optional
# GIBBON_PORT=2005
# BBB_PORT=2006
# PHP_VERSION=8.4
# TEST_PHP_VERSION=8.2

# Optional Gibbon release (default v30.0.02). Tested releases, with the SHA-256 of their InstallBundle.tar.gz
# (run older releases on PHP_VERSION=8.2, the module's minimum):
#   v30.0.02 2dffb380ff9d7f9b815fbfc3ee8b8308bef2728f09a24e5084fd4901df77eeca
#   v29.0.00 ce64680f6eba3af1a84920370d9a89d8346baea4acc621a947c1a77235c9ea84
#   v28.0.01 f60278038fa4a85dc2efda0a7c945691fe6a901955539272ff98bff22d20d629
#   v27.0.01 83cb30bcc7f03b4de797ed95b7f62d914a90f2b9df73aeba8e6fca4ec16b14e9
#   v26.0.00 3833bad2b7897689dbfd797411e5c6b999401900f31e4f92dd487a276d0f6b62
#   v25.0.01 99a8f1b29ac759569e7f7d1959d0a25dd12fd6e68cb6a0a7cd04dcdea59cd609
# GIBBON_VERSION=v29.0.00
# GIBBON_SHA256=ce64680f6eba3af1a84920370d9a89d8346baea4acc621a947c1a77235c9ea84

# Optional HTTPS front (profile "tls"), needed to test embedded camera/microphone
# GIBBON_TLS_HOST=docker-host.example
# GIBBON_TLS_PORT=2007
