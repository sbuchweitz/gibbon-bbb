# Copy to .env (git-ignored). Both addresses must be reachable from your browser AND from the containers,
# and should use different hosts so the BigBlueButton iframe is cross-site, as in a real deployment.
# Example: GIBBON_URL by host name, BBB_PUBLIC_URL by the same machine's IP address.
GIBBON_URL=http://docker-host.example:2005
BBB_PUBLIC_URL=http://192.0.2.10:2006

# Optional
# GIBBON_PORT=2005
# BBB_PORT=2006
# PHP_VERSION=8.4
# TEST_PHP_VERSION=8.2

# Optional HTTPS front (profile "tls"), needed to test embedded camera/microphone
# GIBBON_TLS_HOST=docker-host.example
# GIBBON_TLS_PORT=2007
